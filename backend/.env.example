# Server sozlamalari
PORT=4000

# Frontendingiz manzili (Vercel domeningiz). Bir nechtasini vergul bilan yozing.
# Masalan: https://bilimler-dueli.vercel.app,http://localhost:5500
CORS_ORIGIN=http://localhost:5500

# JWT tokenlarini imzolash uchun maxfiy kalit — buni albatta o'zgartiring!
JWT_SECRET=change-this-to-a-long-random-string

# Token necha kun amal qiladi
JWT_EXPIRES_IN=14d

# SQLite fayli qayerda saqlansin
DB_PATH=./data/bilimdueli.db
TEACHER_INVITE_CODE=Bilim2026Ustoz